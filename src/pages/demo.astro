---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="功能演示 - 背景、音效、动画" description="展示如何添加背景图片、音效和动画效果" />
		<style>
			/* 全屏背景图片 */
			.hero-section {
				min-height: 100vh;
				background-image: url('https://images.unsplash.com/photo-1519681393784-d120267933ba');
				background-size: cover;
				background-position: center;
				background-attachment: fixed;
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			/* 半透明遮罩 */
			.hero-overlay {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: rgba(0, 0, 0, 0.5);
			}

			/* 内容容器 */
			.hero-content {
				position: relative;
				z-index: 1;
				text-align: center;
				color: white;
				padding: 2rem;
			}

			/* 动画标题 */
			.animated-title {
				font-size: 3rem;
				font-weight: bold;
				animation: fadeInUp 1s ease-out;
			}

			/* 动画按钮 */
			.animated-button {
				display: inline-block;
				margin: 1rem;
				padding: 1rem 2rem;
				background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
				color: white;
				border: none;
				border-radius: 50px;
				font-size: 1.2rem;
				cursor: pointer;
				transition: all 0.3s ease;
				animation: fadeInUp 1.5s ease-out;
			}

			.animated-button:hover {
				transform: translateY(-5px) scale(1.05);
				box-shadow: 0 10px 30px rgba(102, 126, 234, 0.5);
			}

			/* 浮动动画卡片 */
			.floating-card {
				background: rgba(255, 255, 255, 0.1);
				backdrop-filter: blur(10px);
				border-radius: 20px;
				padding: 2rem;
				margin: 2rem auto;
				max-width: 600px;
				animation: float 3s ease-in-out infinite;
			}

			/* 粒子效果容器 */
			.particles {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				overflow: hidden;
				pointer-events: none;
			}

			.particle {
				position: absolute;
				width: 4px;
				height: 4px;
				background: white;
				border-radius: 50%;
				animation: rise 10s linear infinite;
			}

			/* 音效控制按钮 */
			.sound-control {
				position: fixed;
				bottom: 2rem;
				right: 2rem;
				z-index: 1000;
				background: rgba(255, 255, 255, 0.2);
				backdrop-filter: blur(10px);
				border: 2px solid rgba(255, 255, 255, 0.3);
				border-radius: 50%;
				width: 60px;
				height: 60px;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: all 0.3s ease;
			}

			.sound-control:hover {
				transform: scale(1.1);
				background: rgba(255, 255, 255, 0.3);
			}

			/* 动画定义 */
			@keyframes fadeInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes float {
				0%, 100% {
					transform: translateY(0px);
				}
				50% {
					transform: translateY(-20px);
				}
			}

			@keyframes rise {
				from {
					bottom: -10px;
					opacity: 1;
				}
				to {
					bottom: 100%;
					opacity: 0;
				}
			}

			@keyframes pulse {
				0%, 100% {
					transform: scale(1);
				}
				50% {
					transform: scale(1.05);
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<div class="hero-section">
			<div class="hero-overlay"></div>

			<!-- 粒子效果 -->
			<div class="particles" id="particles"></div>

			<div class="hero-content">
				<h1 class="animated-title">✨ Astro 功能演示 ✨</h1>

				<div class="floating-card">
					<p style="font-size: 1.2rem; line-height: 1.8;">
						这个页面展示了 Astro 的强大功能：<br>
						🎨 背景图片 + 半透明遮罩<br>
						🎵 音效控制<br>
						✨ CSS 动画效果<br>
						🌟 粒子特效<br>
						💫 悬停交互
					</p>
				</div>

				<button class="animated-button" id="playSound">
					🎵 播放音效
				</button>

				<button class="animated-button" id="triggerAnimation">
					✨ 触发动画
				</button>
			</div>
		</div>

		<!-- 音效控制按钮 -->
		<div class="sound-control" id="soundToggle" title="背景音乐">
			<span style="font-size: 1.5rem;">🔊</span>
		</div>

		<Footer />

		<script>
			// 创建粒子效果
			function createParticles() {
				const container = document.getElementById('particles');
				if (!container) return;

				for (let i = 0; i < 50; i++) {
					const particle = document.createElement('div');
					particle.className = 'particle';
					particle.style.left = Math.random() * 100 + '%';
					particle.style.animationDelay = Math.random() * 10 + 's';
					particle.style.animationDuration = (Math.random() * 10 + 5) + 's';
					container.appendChild(particle);
				}
			}

			// 播放音效（使用 Web Audio API 生成简单音效）
			function playClickSound() {
				const audioContext = new (window.AudioContext || window.webkitAudioContext)();
				const oscillator = audioContext.createOscillator();
				const gainNode = audioContext.createGain();

				oscillator.connect(gainNode);
				gainNode.connect(audioContext.destination);

				oscillator.frequency.value = 800;
				oscillator.type = 'sine';

				gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
				gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);

				oscillator.start(audioContext.currentTime);
				oscillator.stop(audioContext.currentTime + 0.5);
			}

			// 触发动画效果
			function triggerAnimation() {
				const card = document.querySelector('.floating-card');
				if (card) {
					card.style.animation = 'none';
					setTimeout(() => {
						card.style.animation = 'pulse 0.5s ease-in-out, float 3s ease-in-out infinite';
					}, 10);
				}
			}

			// 背景音乐控制（示例）
			let isMusicPlaying = false;
			function toggleMusic() {
				const button = document.getElementById('soundToggle');
				if (!button) return;

				isMusicPlaying = !isMusicPlaying;
				button.innerHTML = isMusicPlaying
					? '<span style="font-size: 1.5rem;">🔊</span>'
					: '<span style="font-size: 1.5rem;">🔇</span>';

				// 这里可以添加实际的音乐播放逻辑
				if (isMusicPlaying) {
					playClickSound();
				}
			}

			// 初始化
			document.addEventListener('DOMContentLoaded', () => {
				createParticles();

				const playSoundBtn = document.getElementById('playSound');
				const triggerAnimBtn = document.getElementById('triggerAnimation');
				const soundToggle = document.getElementById('soundToggle');

				if (playSoundBtn) {
					playSoundBtn.addEventListener('click', playClickSound);
				}

				if (triggerAnimBtn) {
					triggerAnimBtn.addEventListener('click', () => {
						triggerAnimation();
						playClickSound();
					});
				}

				if (soundToggle) {
					soundToggle.addEventListener('click', toggleMusic);
				}
			});
		</script>
	</body>
</html>
