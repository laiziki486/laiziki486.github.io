---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="时间的碎片" description="漂浮在记忆与遗忘中" />
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--primary-hue: 209;
				--opacity: 0.3;
			}

			body {
				font-family: 'Georgia', 'Songti SC', serif;
				background: url('/background.jpg') center/cover fixed;
				color: #fff;
				overflow-x: hidden;
				min-height: 100vh;
				max-height: 100vh;
				height: 100vh;
				perspective: 1500px;
				position: relative;
			}

			/* 星际穿梭Canvas */
			#starfield {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				z-index: 1;
				pointer-events: none;
				background: transparent;
			}

			/* 背景动态模糊效果 */
			body::before {
				content: '';
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: url('/background.jpg') center/cover fixed;
				animation: bgPulse 4s ease-in-out infinite;
				z-index: -1;
			}

			@keyframes bgPulse {
				0%, 100% {
					filter: blur(0px);
				}
				50% {
					filter: blur(3px);
				}
			}

			.overlay {
				display: none;
			}

			/* 破碎文字效果 */
			.glitch-text {
				position: relative;
				display: inline-block;
			}

			.glitch-text::before,
			.glitch-text::after {
				content: attr(data-text);
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
			}

			.glitch-text::before {
				left: 2px;
				text-shadow: -2px 0 #ff00de;
				clip: rect(24px, 9999px, 90px, 0);
				animation: glitch-anim 2s infinite linear alternate-reverse;
			}

			.glitch-text::after {
				left: -2px;
				text-shadow: -2px 0 #00fff9, 2px 2px #ff00de;
				clip: rect(85px, 9999px, 140px, 0);
				animation: glitch-anim 3s infinite linear alternate-reverse;
			}

			@keyframes glitch-anim {
				0% { clip: rect(61px, 9999px, 50px, 0); transform: skew(0.5deg); }
				10% { clip: rect(91px, 9999px, 28px, 0); transform: skew(-0.3deg); }
				20% { clip: rect(65px, 9999px, 73px, 0); transform: skew(0.8deg); }
				30% { clip: rect(17px, 9999px, 14px, 0); transform: skew(-0.5deg); }
				40% { clip: rect(53px, 9999px, 96px, 0); transform: skew(0.4deg); }
				50% { clip: rect(37px, 9999px, 81px, 0); transform: skew(-0.6deg); }
				60% { clip: rect(72px, 9999px, 43px, 0); transform: skew(0.3deg); }
				70% { clip: rect(26px, 9999px, 58px, 0); transform: skew(-0.4deg); }
				80% { clip: rect(84px, 9999px, 11px, 0); transform: skew(0.7deg); }
				90% { clip: rect(19px, 9999px, 67px, 0); transform: skew(-0.2deg); }
				100% { clip: rect(45px, 9999px, 32px, 0); transform: skew(0.5deg); }
			}

			.container {
				position: relative;
				z-index: 2;
				max-width: 1200px;
				margin: 0 auto;
				padding: 2rem;
				min-height: 100vh;
				max-height: 100vh;
				height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				background: transparent;
				overflow: hidden;
			}

			.header {
				text-align: center;
				margin-bottom: 5rem;
				animation: fadeInDown 1.5s ease-out;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.avatar {
				width: 120px;
				height: 120px;
				border-radius: 50%;
				border: 3px solid rgba(255, 255, 255, 0.3);
				margin: 0 auto 1.5rem;
				animation: shatter 8s ease-in-out infinite;
				box-shadow: 0 0 40px rgba(255, 255, 255, 0.5);
				filter: brightness(1.1);
				display: block;
			}

			.site-title {
				font-size: 3rem;
				font-weight: 300;
				letter-spacing: 0.5rem;
				margin-bottom: 0.5rem;
				text-shadow: 0 0 30px rgba(255, 255, 255, 0.6);
			}

			.site-subtitle {
				font-size: 1.1rem;
				opacity: 0.8;
				font-style: italic;
				letter-spacing: 0.3rem;
				animation: flicker 4s infinite;
				margin-left: -0.5rem;
			}

			/* 3D旋转文档柜 - 俯视7度 */
			.carousel-container {
				width: 100%;
				height: 550px;
				position: relative;
				transform-style: preserve-3d;
				transform: rotateX(-7deg);
			}

			.carousel {
				width: 100%;
				height: 100%;
				position: absolute;
				transform-style: preserve-3d;
				animation: rotate 40s infinite linear;
			}

			.document {
				position: absolute;
				width: 320px;
				height: 420px;
				left: 50%;
				top: 50%;
				margin-left: -160px;
				margin-top: -210px;
				background: hsla(var(--primary-hue), 30%, 20%, calc(var(--opacity) * 0.7));
				backdrop-filter: blur(8px);
				border: 2px solid rgba(255, 255, 255, 0.3);
				border-radius: 15px;
				padding: 2rem;
				cursor: pointer;
				transform-style: preserve-3d;
				box-shadow: 0 15px 60px rgba(0, 0, 0, 0.6),
				            inset 0 0 20px rgba(255, 255, 255, 0.1);
				clip-path: polygon(
					0% 2%, 2% 0%, 98% 0%, 100% 3%,
					100% 97%, 98% 100%, 2% 100%, 0% 98%
				);
				transition: background 0.3s, box-shadow 0.3s, border-color 0.3s;
			}

			.document::before {
				content: '';
				position: absolute;
				top: -2px;
				left: -2px;
				right: -2px;
				bottom: -2px;
				background: linear-gradient(45deg,
					transparent 30%,
					rgba(255, 255, 255, 0.3) 50%,
					transparent 70%);
				border-radius: 15px;
				opacity: 0;
				transition: opacity 0.6s;
				pointer-events: none;
				clip-path: polygon(
					0% 2%, 2% 0%, 98% 0%, 100% 3%,
					100% 97%, 98% 100%, 2% 100%, 0% 98%
				);
			}

			.document:hover {
				background: hsla(var(--primary-hue), 40%, 30%, calc(var(--opacity) + 0.2));
				box-shadow: 0 25px 100px rgba(0, 0, 0, 0.8),
				            0 0 50px rgba(255, 255, 255, 0.5),
				            inset 0 0 30px rgba(255, 255, 255, 0.2);
				border-color: rgba(255, 255, 255, 0.6);
				z-index: 100;
			}

			.document:hover::before {
				opacity: 1;
			}

			.document:nth-child(1) { transform: rotateY(0deg) translateZ(500px); }
			.document:nth-child(2) { transform: rotateY(72deg) translateZ(500px); }
			.document:nth-child(3) { transform: rotateY(144deg) translateZ(500px); }
			.document:nth-child(4) { transform: rotateY(216deg) translateZ(500px); }
			.document:nth-child(5) { transform: rotateY(288deg) translateZ(500px); }

			.doc-title {
				font-size: 1.8rem;
				margin-bottom: 1rem;
				color: #fff;
				text-decoration: none;
				display: block;
				text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
				transition: all 0.3s;
			}

			.document:hover .doc-title {
				text-shadow: 0 0 20px rgba(255, 255, 255, 0.8);
			}

			.doc-date {
				font-size: 0.9rem;
				opacity: 0.8;
				margin-bottom: 1.5rem;
				letter-spacing: 0.1rem;
				color: rgba(255, 255, 255, 0.85);
			}

			.doc-excerpt {
				line-height: 1.8;
				opacity: 0.95;
				font-size: 0.95rem;
				color: rgba(255, 255, 255, 0.98);
			}

			/* 精致的控制按钮 */
			.control-btn {
				position: fixed;
				width: 70px;
				height: 70px;
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 60%, 40%, 0.4),
					hsla(var(--primary-hue), 60%, 30%, 0.6));
				backdrop-filter: blur(15px);
				border: 2px solid rgba(255, 255, 255, 0.4);
				border-radius: 50%;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.8rem;
				transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
				z-index: 1000;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4),
				            inset 0 0 20px rgba(255, 255, 255, 0.1);
			}

			.control-btn::before {
				content: '';
				position: absolute;
				inset: -2px;
				border-radius: 50%;
				padding: 2px;
				background: linear-gradient(45deg,
					transparent,
					rgba(255, 255, 255, 0.5),
					transparent);
				-webkit-mask: linear-gradient(#fff 0 0) content-box,
				              linear-gradient(#fff 0 0);
				-webkit-mask-composite: xor;
				mask-composite: exclude;
				opacity: 0;
				transition: opacity 0.4s;
			}

			.control-btn:hover {
				transform: scale(1.15);
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 70%, 50%, 0.6),
					hsla(var(--primary-hue), 70%, 40%, 0.8));
				box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6),
				            0 0 40px rgba(255, 255, 255, 0.4),
				            inset 0 0 30px rgba(255, 255, 255, 0.2);
				border-color: rgba(255, 255, 255, 0.8);
			}

			.control-btn:hover::before {
				opacity: 1;
			}

			.control-btn:active {
				transform: scale(1.05);
			}

			/* 径向菜单容器 */
			.radial-menu {
				position: fixed;
				bottom: 2rem;
				right: 2rem;
				z-index: 1000;
				width: 200px;
				height: 200px;
			}

			.radial-menu-center {
				position: absolute;
				bottom: 0;
				right: 0;
				width: 70px;
				height: 70px;
				z-index: 1001;
			}

			/* 径向菜单子按钮 */
			.radial-item {
				position: absolute;
				width: 60px;
				height: 60px;
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 60%, 40%, 0.4),
					hsla(var(--primary-hue), 60%, 30%, 0.6));
				backdrop-filter: blur(15px);
				border: 2px solid rgba(255, 255, 255, 0.4);
				border-radius: 50%;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.5rem;
				transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4),
				            inset 0 0 20px rgba(255, 255, 255, 0.1);
				opacity: 0;
				pointer-events: none;
				transform: scale(0);
				bottom: 5px;
				right: 5px;
				z-index: 1002;
			}

			.radial-menu:hover .radial-item {
				opacity: 1;
				pointer-events: auto;
			}

			.radial-item:hover {
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 70%, 50%, 0.6),
					hsla(var(--primary-hue), 70%, 40%, 0.8));
				box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6),
				            0 0 40px rgba(255, 255, 255, 0.4),
				            inset 0 0 30px rgba(255, 255, 255, 0.2);
				border-color: rgba(255, 255, 255, 0.8);
				z-index: 1003;
			}

			/* 径向菜单布局 - 圆环分布 */
			.radial-item:nth-child(2) {
				transform: scale(0);
				transition-delay: 0s;
			}

			.radial-item:nth-child(3) {
				transform: scale(0);
				transition-delay: 0s;
			}

			.radial-menu:hover .radial-item:nth-child(2) {
				transform: translate(-70px, -70px) scale(1);
				transition-delay: 0.05s;
			}

			.radial-menu:hover .radial-item:nth-child(3) {
				transform: translate(0px, -90px) scale(1);
				transition-delay: 0.1s;
			}

			.settings-panel {
				position: fixed;
				bottom: 5.5rem;
				right: 2rem;
				width: 320px;
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 30%, 20%, 0.95),
					hsla(var(--primary-hue), 30%, 15%, 0.98));
				backdrop-filter: blur(25px);
				border: 2px solid rgba(255, 255, 255, 0.3);
				border-radius: 20px;
				padding: 2rem;
				display: none;
				z-index: 999;
				animation: slideInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6),
				            inset 0 0 30px rgba(255, 255, 255, 0.05);
			}

			.settings-panel.active {
				display: block;
			}

			.setting-item {
				margin-bottom: 2rem;
			}

			.setting-item:last-child {
				margin-bottom: 0;
			}

			.setting-label {
				display: block;
				margin-bottom: 0.8rem;
				font-size: 0.95rem;
				opacity: 0.9;
				letter-spacing: 0.05rem;
			}

			.slider {
				width: 100%;
				height: 8px;
				border-radius: 4px;
				background: linear-gradient(90deg,
					rgba(255, 255, 255, 0.2),
					rgba(255, 255, 255, 0.4));
				outline: none;
				-webkit-appearance: none;
				position: relative;
			}

			.slider::-webkit-slider-thumb {
				-webkit-appearance: none;
				width: 20px;
				height: 20px;
				border-radius: 50%;
				background: linear-gradient(135deg,
					hsl(var(--primary-hue), 80%, 60%),
					hsl(var(--primary-hue), 80%, 50%));
				cursor: pointer;
				box-shadow: 0 4px 12px rgba(255, 255, 255, 0.5),
				            inset 0 0 8px rgba(255, 255, 255, 0.3);
				transition: all 0.3s;
			}

			.slider::-webkit-slider-thumb:hover {
				transform: scale(1.2);
				box-shadow: 0 6px 20px rgba(255, 255, 255, 0.7),
				            inset 0 0 12px rgba(255, 255, 255, 0.4);
			}

			@keyframes rotate {
				from { transform: rotateY(0deg); }
				to { transform: rotateY(360deg); }
			}

			@keyframes fadeInDown {
				from {
					opacity: 0;
					transform: translateY(-50px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			/* 头像破碎特效 - 硬编码 */
			@keyframes avatarShatter {
				0%, 85%, 100% {
					clip-path: circle(50% at 50% 50%);
					filter: brightness(1.1);
					transform: scale(1);
				}
				87% {
					clip-path: polygon(
						50% 0%, 61% 35%, 98% 35%, 68% 57%,
						79% 91%, 50% 70%, 21% 91%, 32% 57%,
						2% 35%, 39% 35%
					);
					filter: brightness(1.4) contrast(1.2);
					transform: scale(1.02);
				}
				89% {
					clip-path: polygon(
						50% 5%, 65% 30%, 95% 30%, 72% 55%,
						82% 88%, 50% 68%, 18% 88%, 28% 55%,
						5% 30%, 35% 30%
					);
					filter: brightness(1.6) contrast(1.3);
					transform: scale(1.03);
				}
				91% {
					clip-path: polygon(
						50% 10%, 70% 25%, 90% 25%, 75% 50%,
						85% 85%, 50% 65%, 15% 85%, 25% 50%,
						10% 25%, 30% 25%
					);
					filter: brightness(1.3) contrast(1.1);
					transform: scale(1.01);
				}
			}

			.avatar {
				width: 120px;
				height: 120px;
				border-radius: 50%;
				border: 3px solid rgba(255, 255, 255, 0.3);
				margin: 0 auto 1.5rem;
				animation: avatarShatter 8s ease-in-out infinite;
				box-shadow: 0 0 40px rgba(255, 255, 255, 0.5);
				filter: brightness(1.1);
				display: block;
			}

			@keyframes flicker {
				0%, 100% { opacity: 0.8; }
				50% { opacity: 0.5; }
			}

			@keyframes slideInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
		</style>
	</head>
	<body>
		<!-- 星际穿梭粒子效果 Canvas -->
		<canvas id="starfield"></canvas>

		<div class="overlay"></div>

		<div class="container">
			<header class="header">
				<img src="/avatar.jpg" alt="Avatar" class="avatar" />
				<h1 class="site-title glitch-text" data-text="时间的碎片">时间的碎片</h1>
				<p class="site-subtitle glitch-text" data-text="漂浮在记忆与遗忘中">漂浮在记忆与遗忘中</p>
			</header>

			<div class="carousel-container">
				<div class="carousel" id="carousel">
					<a href="/blog/fragment-1" class="document">
						<h2 class="doc-title glitch-text" data-text="玻璃上的裂痕">玻璃上的裂痕</h2>
						<div class="doc-date">2026.03.14</div>
						<p class="doc-excerpt">
							时钟停在了三点十五分。窗外的雨一直在下。手心的纹路像是某种古老的密码。我盯着看了很久。
						</p>
					</a>

					<a href="/blog/fragment-2" class="document">
						<h2 class="doc-title glitch-text" data-text="蓝色的回声">蓝色的回声</h2>
						<div class="doc-date">2026.02.28</div>
						<p class="doc-excerpt">
							梦里有人在唱歌。醒来时嘴里还残留着旋律的碎片。每一个音符都指向不同的方向。
						</p>
					</a>

					<a href="/blog/fragment-3" class="document">
						<h2 class="doc-title glitch-text" data-text="漂浮的房间">漂浮的房间</h2>
						<div class="doc-date">2026.01.17</div>
						<p class="doc-excerpt">
							墙壁开始呼吸。我数着它的节奏。一下，两下，三下。然后忘记了为什么要数。
						</p>
					</a>

					<a href="/blog/fragment-4" class="document">
						<h2 class="doc-title glitch-text" data-text="透明的重量">透明的重量</h2>
						<div class="doc-date">2025.12.09</div>
						<p class="doc-excerpt">
							空气有重量吗？我把手伸进虚空。感觉到了什么。或许什么都没有。镜子里的人在笑。
						</p>
					</a>

					<a href="/blog/fragment-5" class="document">
						<h2 class="doc-title glitch-text" data-text="消失的边界">消失的边界</h2>
						<div class="doc-date">2025.11.23</div>
						<p class="doc-excerpt">
							哪里是开始，哪里是结束？我站在两者之间。花瓣在空中旋转，永远不会落地。
						</p>
					</a>
				</div>
			</div>
		</div>

		<!-- 径向菜单 -->
		<div class="radial-menu">
			<div class="radial-menu-center">
				<div class="control-btn" id="mainMenuBtn">
					☰
				</div>
				<div class="radial-item" id="musicControl">
					<span id="musicIcon">🎶</span>
				</div>
				<div class="radial-item" id="settingsBtn">
					⚙️
				</div>
			</div>
		</div>

		<div class="settings-panel" id="settingsPanel">
			<div class="setting-item">
				<label class="setting-label">透明度: <span id="opacityValue">30%</span></label>
				<input type="range" min="10" max="90" value="30" class="slider" id="opacitySlider" />
			</div>
			<div class="setting-item">
				<label class="setting-label">主题色调: <span id="hueValue">209°</span></label>
				<input type="range" min="0" max="360" value="209" class="slider" id="hueSlider" />
			</div>
		</div>

		<audio id="bgMusic" loop autoplay>
			<source src="/music.mp3" type="audio/mpeg" />
		</audio>

		<script>
			// 音乐控制 - 尝试自动播放
			const music = document.getElementById('bgMusic');
			const musicControl = document.getElementById('musicControl');
			const musicIcon = document.getElementById('musicIcon');
			let isPlaying = false;

			// 尝试自动播放
			const playPromise = music.play();
			if (playPromise !== undefined) {
				playPromise.then(() => {
					isPlaying = true;
					musicIcon.textContent = '🎶';
				}).catch(() => {
					isPlaying = false;
					musicIcon.textContent = '🎵';
				});
			}

			musicControl.addEventListener('click', (e) => {
				e.stopPropagation();
				if (isPlaying) {
					music.pause();
					musicIcon.textContent = '🎵';
					isPlaying = false;
				} else {
					music.play().then(() => {
						musicIcon.textContent = '🎶';
						isPlaying = true;
					});
				}
			});

			// 设置面板
			const settingsBtn = document.getElementById('settingsBtn');
			const settingsPanel = document.getElementById('settingsPanel');

			settingsBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				settingsPanel.classList.toggle('active');
			});

			// 透明度控制
			const opacitySlider = document.getElementById('opacitySlider');
			const opacityValue = document.getElementById('opacityValue');

			opacitySlider.addEventListener('input', (e) => {
				const value = e.target.value / 100;
				document.documentElement.style.setProperty('--opacity', value);
				opacityValue.textContent = e.target.value + '%';
			});

			// 色调控制
			const hueSlider = document.getElementById('hueSlider');
			const hueValue = document.getElementById('hueValue');

			hueSlider.addEventListener('input', (e) => {
				document.documentElement.style.setProperty('--primary-hue', e.target.value);
				hueValue.textContent = e.target.value + '°';
			});

			// 星际穿梭粒子系统
			const canvas = document.getElementById('starfield');
			const ctx = canvas.getContext('2d');

			// 设置Canvas尺寸
			function resizeCanvas() {
				canvas.width = window.innerWidth;
				canvas.height = window.innerHeight;
			}
			resizeCanvas();
			window.addEventListener('resize', resizeCanvas);

			// 粒子类
			class Particle {
				constructor() {
					this.reset();
				}

				reset() {
					// 从圆环位置开始（而不是中心点）
					const ringRadius = 30; // 圆环半径 - 缩小圆环
					const angle = Math.random() * Math.PI * 2;

					// 圆环上的起始位置
					this.x = canvas.width / 2 + Math.cos(angle) * ringRadius;
					this.y = canvas.height / 2 + Math.sin(angle) * ringRadius;

					// 运动方向（从圆环向外辐射）
					this.angle = angle;

					// 深度（0-1，0最远，1最近）- 总是从圆环开始
					this.z = 0;

					// 速度（增加速度让粒子动起来）
					this.speed = 0.003 + Math.random() * 0.005;

					// 初始化位置
					this.updatePosition();
				}

				update() {
					// 深度增加（粒子向前移动）
					this.z += this.speed;

					// 当粒子到达最前方时重置
					if (this.z >= 1) {
						this.reset();
						return;
					}

					this.updatePosition();
				}

				updatePosition() {
					// 基于深度计算实际位置（透视效果）
					// z越大，粒子离观察者越近，扩散得越远
					const ringRadius = 10; // 与reset()中保持一致

					// 从圆环中心向外扩散的距离
					// 使用对角线长度确保覆盖整个屏幕
					const maxDistance = Math.sqrt(canvas.width * canvas.width + canvas.height * canvas.height) / 2;
					const spreadDistance = this.z * maxDistance * 1.2;

					// 当z=0时，粒子在圆环上；当z=1时，粒子在屏幕边缘外
					this.currentX = canvas.width / 2 + Math.cos(this.angle) * (ringRadius + spreadDistance);
					this.currentY = canvas.height / 2 + Math.sin(this.angle) * (ringRadius + spreadDistance);
				}

				draw() {
					// 基于深度计算大小（近大远小）
					const size = this.z * 3.0;

					// 基于深度计算透明度和亮度（近的亮且清晰，远的暗且模糊）
					const alpha = Math.pow(this.z, 0.3);
					const brightness = 280 + this.z * 25;

					// 绘制粒子
					ctx.beginPath();

					// 远的粒子模糊效果（通过多次绘制半透明圆实现）
					if (this.z < 0.3) {
						// 远处粒子 - 模糊效果
						const blurRadius = size * 2;
						const gradient = ctx.createRadialGradient(
							this.currentX, this.currentY, 0,
							this.currentX, this.currentY, blurRadius
						);
						gradient.addColorStop(0, `rgba(${brightness}, ${brightness}, ${brightness}, ${alpha * 0.8})`);
						gradient.addColorStop(1, `rgba(${brightness}, ${brightness}, ${brightness}, 0)`);
						ctx.fillStyle = gradient;
						ctx.arc(this.currentX, this.currentY, blurRadius, 0, Math.PI * 2);
						ctx.fill();
					} else {
						// 近处粒子 - 清晰明亮
						ctx.fillStyle = `rgba(${brightness}, ${brightness}, ${brightness}, ${alpha})`;
						ctx.arc(this.currentX, this.currentY, size, 0, Math.PI * 2);
						ctx.fill();

						// 添加光晕效果
						const glowGradient = ctx.createRadialGradient(
							this.currentX, this.currentY, 0,
							this.currentX, this.currentY, size * 3
						);
						glowGradient.addColorStop(0, `rgba(255, 255, 255, ${alpha * 0.5})`);
						glowGradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
						ctx.fillStyle = glowGradient;
						ctx.beginPath();
						ctx.arc(this.currentX, this.currentY, size * 3, 0, Math.PI * 2);
						ctx.fill();
					}
				}
			}

			// 创建粒子数组
			const particles = [];
			const particleCount = 800; // 粒子数量

			for (let i = 0; i < particleCount; i++) {
				const particle = new Particle();
				// 所有粒子都从圆环(z=0)开始，不再随机分布
				// 这样可以看到清晰的圆环起点
				particles.push(particle);
			}

			// 动画循环
			function animate() {
				// 完全清除画布，不使用半透明黑色（避免遮挡背景）
				ctx.clearRect(0, 0, canvas.width, canvas.height);

				// 更新和绘制所有粒子
				particles.forEach(particle => {
					particle.update();
					particle.draw();
				});

				requestAnimationFrame(animate);
			}

			// 启动动画
			animate();
		</script>
	</body>
</html>
