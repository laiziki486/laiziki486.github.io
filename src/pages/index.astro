---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="时间的碎片" description="漂浮在记忆与遗忘之间" />
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--primary-hue: 209;
				--opacity: 0.3;
			}

			body {
				font-family: 'Georgia', 'Songti SC', serif;
				background: url('/background.jpg') center/cover fixed;
				color: #fff;
				overflow-x: hidden;
				min-height: 100vh;
				perspective: 1500px;
				position: relative;
			}

			/* 背景动态模糊效果 */
			body::before {
				content: '';
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: url('/background.jpg') center/cover fixed;
				animation: bgPulse 4s ease-in-out infinite;
				z-index: -1;
			}

			@keyframes bgPulse {
				0%, 100% {
					filter: blur(0px);
				}
				50% {
					filter: blur(3px);
				}
			}

			.overlay {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: rgba(0, 0, 0, 0.5);
				pointer-events: none;
				z-index: 0;
			}

			/* 往背景深处坠落的粒子效果 */
			.falling-particles {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 999;
				overflow: hidden;
			}

			.particle {
				position: absolute;
				left: 50%;
				top: 50%;
				width: 2px;
				height: 2px;
				background: rgba(255, 255, 255, 1);
				border-radius: 50%;
				box-shadow: 0 0 10px rgba(255, 255, 255, 1);
			}

			/* 星际穿梭效果：从中心向外辐射延伸成透视光线 */
			@keyframes warpSpeed {
				0% {
					transform: translate(0, 0) rotate(var(--angle)) scaleY(1);
					opacity: 0;
				}
				10% {
					opacity: 1;
				}
				100% {
					transform: translate(var(--tx), var(--ty)) rotate(var(--angle)) scaleY(80);
					opacity: 0;
					filter: blur(1px);
				}
			}

			/* 破碎文字效果 */
			.glitch-text {
				position: relative;
				display: inline-block;
			}

			.glitch-text::before,
			.glitch-text::after {
				content: attr(data-text);
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
			}

			.glitch-text::before {
				left: 2px;
				text-shadow: -2px 0 #ff00de;
				clip: rect(24px, 9999px, 90px, 0);
				animation: glitch-anim 2s infinite linear alternate-reverse;
			}

			.glitch-text::after {
				left: -2px;
				text-shadow: -2px 0 #00fff9, 2px 2px #ff00de;
				clip: rect(85px, 9999px, 140px, 0);
				animation: glitch-anim 3s infinite linear alternate-reverse;
			}

			@keyframes glitch-anim {
				0% { clip: rect(61px, 9999px, 50px, 0); transform: skew(0.5deg); }
				10% { clip: rect(91px, 9999px, 28px, 0); transform: skew(-0.3deg); }
				20% { clip: rect(65px, 9999px, 73px, 0); transform: skew(0.8deg); }
				30% { clip: rect(17px, 9999px, 14px, 0); transform: skew(-0.5deg); }
				40% { clip: rect(53px, 9999px, 96px, 0); transform: skew(0.4deg); }
				50% { clip: rect(37px, 9999px, 81px, 0); transform: skew(-0.6deg); }
				60% { clip: rect(72px, 9999px, 43px, 0); transform: skew(0.3deg); }
				70% { clip: rect(26px, 9999px, 58px, 0); transform: skew(-0.4deg); }
				80% { clip: rect(84px, 9999px, 11px, 0); transform: skew(0.7deg); }
				90% { clip: rect(19px, 9999px, 67px, 0); transform: skew(-0.2deg); }
				100% { clip: rect(45px, 9999px, 32px, 0); transform: skew(0.5deg); }
			}

			.container {
				position: relative;
				z-index: 2;
				max-width: 1200px;
				margin: 0 auto;
				padding: 2rem;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
			}

			.header {
				text-align: center;
				margin-bottom: 5rem;
				animation: fadeInDown 1.5s ease-out;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.avatar {
				width: 120px;
				height: 120px;
				border-radius: 50%;
				border: 3px solid rgba(255, 255, 255, 0.3);
				margin: 0 auto 1.5rem;
				animation: float 6s ease-in-out infinite;
				box-shadow: 0 0 40px rgba(135, 206, 250, 0.5);
				filter: brightness(1.1);
				display: block;
			}

			.site-title {
				font-size: 3rem;
				font-weight: 300;
				letter-spacing: 0.5rem;
				margin-bottom: 0.5rem;
				text-shadow: 0 0 30px rgba(135, 206, 250, 0.6);
			}

			.site-subtitle {
				font-size: 1.1rem;
				opacity: 0.8;
				font-style: italic;
				letter-spacing: 0.3rem;
				animation: flicker 4s infinite;
			}

			/* 3D旋转文档柜 - 俯视7度 */
			.carousel-container {
				width: 100%;
				height: 550px;
				position: relative;
				transform-style: preserve-3d;
				transform: rotateX(-7deg);
			}

			.carousel {
				width: 100%;
				height: 100%;
				position: absolute;
				transform-style: preserve-3d;
				animation: rotate 40s infinite linear;
			}

			.document {
				position: absolute;
				width: 320px;
				height: 420px;
				left: 50%;
				top: 50%;
				margin-left: -160px;
				margin-top: -210px;
				background: hsla(var(--primary-hue), 30%, 20%, var(--opacity));
				backdrop-filter: blur(15px);
				border: 2px solid rgba(135, 206, 250, 0.3);
				border-radius: 15px;
				padding: 2rem;
				cursor: pointer;
				transform-style: preserve-3d;
				box-shadow: 0 15px 60px rgba(0, 0, 0, 0.6),
				            inset 0 0 20px rgba(135, 206, 250, 0.1);
				clip-path: polygon(
					0% 2%, 2% 0%, 98% 0%, 100% 3%,
					100% 97%, 98% 100%, 2% 100%, 0% 98%
				);
				transition: background 0.3s, box-shadow 0.3s, border-color 0.3s;
			}

			.document::before {
				content: '';
				position: absolute;
				top: -2px;
				left: -2px;
				right: -2px;
				bottom: -2px;
				background: linear-gradient(45deg,
					transparent 30%,
					rgba(135, 206, 250, 0.3) 50%,
					transparent 70%);
				border-radius: 15px;
				opacity: 0;
				transition: opacity 0.6s;
				pointer-events: none;
				clip-path: polygon(
					0% 2%, 2% 0%, 98% 0%, 100% 3%,
					100% 97%, 98% 100%, 2% 100%, 0% 98%
				);
			}

			.document:hover {
				background: hsla(var(--primary-hue), 40%, 30%, calc(var(--opacity) + 0.2));
				box-shadow: 0 25px 100px rgba(0, 0, 0, 0.8),
				            0 0 50px rgba(135, 206, 250, 0.5),
				            inset 0 0 30px rgba(135, 206, 250, 0.2);
				border-color: rgba(135, 206, 250, 0.6);
				z-index: 100;
			}

			.document:hover::before {
				opacity: 1;
			}

			.document:nth-child(1) { transform: rotateY(0deg) translateZ(500px); }
			.document:nth-child(2) { transform: rotateY(72deg) translateZ(500px); }
			.document:nth-child(3) { transform: rotateY(144deg) translateZ(500px); }
			.document:nth-child(4) { transform: rotateY(216deg) translateZ(500px); }
			.document:nth-child(5) { transform: rotateY(288deg) translateZ(500px); }

			.doc-title {
				font-size: 1.8rem;
				margin-bottom: 1rem;
				color: #fff;
				text-decoration: none;
				display: block;
				text-shadow: 0 0 10px rgba(135, 206, 250, 0.5);
				transition: all 0.3s;
			}

			.document:hover .doc-title {
				text-shadow: 0 0 20px rgba(135, 206, 250, 0.8);
			}

			.doc-date {
				font-size: 0.9rem;
				opacity: 0.6;
				margin-bottom: 1.5rem;
				letter-spacing: 0.1rem;
				color: rgba(200, 200, 200, 0.8);
			}

			.doc-excerpt {
				line-height: 1.8;
				opacity: 0.75;
				font-size: 0.95rem;
				color: rgba(200, 200, 200, 0.9);
			}

			/* 精致的控制按钮 */
			.control-btn {
				position: fixed;
				width: 70px;
				height: 70px;
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 60%, 40%, 0.4),
					hsla(var(--primary-hue), 60%, 30%, 0.6));
				backdrop-filter: blur(15px);
				border: 2px solid rgba(135, 206, 250, 0.4);
				border-radius: 50%;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.8rem;
				transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
				z-index: 1000;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4),
				            inset 0 0 20px rgba(135, 206, 250, 0.1);
			}

			.control-btn::before {
				content: '';
				position: absolute;
				inset: -2px;
				border-radius: 50%;
				padding: 2px;
				background: linear-gradient(45deg,
					transparent,
					rgba(135, 206, 250, 0.5),
					transparent);
				-webkit-mask: linear-gradient(#fff 0 0) content-box,
				              linear-gradient(#fff 0 0);
				-webkit-mask-composite: xor;
				mask-composite: exclude;
				opacity: 0;
				transition: opacity 0.4s;
			}

			.control-btn:hover {
				transform: scale(1.15);
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 70%, 50%, 0.6),
					hsla(var(--primary-hue), 70%, 40%, 0.8));
				box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6),
				            0 0 40px rgba(135, 206, 250, 0.4),
				            inset 0 0 30px rgba(135, 206, 250, 0.2);
				border-color: rgba(135, 206, 250, 0.8);
			}

			.control-btn:hover::before {
				opacity: 1;
			}

			.control-btn:active {
				transform: scale(1.05);
			}

			.music-control {
				bottom: 2rem;
				left: 2rem;
			}

			.settings-btn {
				bottom: 2rem;
				right: 2rem;
			}

			.settings-btn:hover {
				transform: scale(1.15) rotate(90deg);
			}

			.settings-panel {
				position: fixed;
				bottom: 5.5rem;
				right: 2rem;
				width: 320px;
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 30%, 20%, 0.95),
					hsla(var(--primary-hue), 30%, 15%, 0.98));
				backdrop-filter: blur(25px);
				border: 2px solid rgba(135, 206, 250, 0.3);
				border-radius: 20px;
				padding: 2rem;
				display: none;
				z-index: 999;
				animation: slideInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6),
				            inset 0 0 30px rgba(135, 206, 250, 0.05);
			}

			.settings-panel.active {
				display: block;
			}

			.setting-item {
				margin-bottom: 2rem;
			}

			.setting-item:last-child {
				margin-bottom: 0;
			}

			.setting-label {
				display: block;
				margin-bottom: 0.8rem;
				font-size: 0.95rem;
				opacity: 0.9;
				letter-spacing: 0.05rem;
			}

			.slider {
				width: 100%;
				height: 8px;
				border-radius: 4px;
				background: linear-gradient(90deg,
					rgba(135, 206, 250, 0.2),
					rgba(135, 206, 250, 0.4));
				outline: none;
				-webkit-appearance: none;
				position: relative;
			}

			.slider::-webkit-slider-thumb {
				-webkit-appearance: none;
				width: 20px;
				height: 20px;
				border-radius: 50%;
				background: linear-gradient(135deg,
					hsl(var(--primary-hue), 80%, 60%),
					hsl(var(--primary-hue), 80%, 50%));
				cursor: pointer;
				box-shadow: 0 4px 12px rgba(135, 206, 250, 0.5),
				            inset 0 0 8px rgba(255, 255, 255, 0.3);
				transition: all 0.3s;
			}

			.slider::-webkit-slider-thumb:hover {
				transform: scale(1.2);
				box-shadow: 0 6px 20px rgba(135, 206, 250, 0.7),
				            inset 0 0 12px rgba(255, 255, 255, 0.4);
			}

			@keyframes rotate {
				from { transform: rotateY(0deg); }
				to { transform: rotateY(360deg); }
			}

			@keyframes fadeInDown {
				from {
					opacity: 0;
					transform: translateY(-50px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes float {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-20px); }
			}

			@keyframes flicker {
				0%, 100% { opacity: 0.8; }
				50% { opacity: 0.5; }
			}

			@keyframes slideInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
		</style>
	</head>
	<body>
		<div class="overlay"></div>
		<div class="falling-particles" id="fallingParticles">
			<!-- 星际穿梭粒子 - 从中心向外辐射到边缘 -->
			<div class="particle" style="--tx: 800px; --ty: -600px; --angle: -36.87deg; animation: warpSpeed 2s linear infinite;"></div>
			<div class="particle" style="--tx: -800px; --ty: 600px; --angle: 143.13deg; animation: warpSpeed 2.2s linear infinite 0.1s;"></div>
			<div class="particle" style="--tx: 1000px; --ty: 400px; --angle: 21.8deg; animation: warpSpeed 1.8s linear infinite 0.2s;"></div>
			<div class="particle" style="--tx: -900px; --ty: -700px; --angle: -142.13deg; animation: warpSpeed 2.5s linear infinite 0.3s;"></div>
			<div class="particle" style="--tx: 700px; --ty: 800px; --angle: 48.81deg; animation: warpSpeed 2.1s linear infinite 0.4s;"></div>
			<div class="particle" style="--tx: -1000px; --ty: 200px; --angle: 168.69deg; animation: warpSpeed 1.9s linear infinite 0.5s;"></div>
			<div class="particle" style="--tx: 900px; --ty: -400px; --angle: -23.96deg; animation: warpSpeed 2.3s linear infinite 0.6s;"></div>
			<div class="particle" style="--tx: -700px; --ty: 700px; --angle: 135deg; animation: warpSpeed 2s linear infinite 0.7s;"></div>
			<div class="particle" style="--tx: 850px; --ty: -800px; --angle: -43.24deg; animation: warpSpeed 2.4s linear infinite 0.8s;"></div>
			<div class="particle" style="--tx: -950px; --ty: -300px; --angle: -162.53deg; animation: warpSpeed 1.7s linear infinite 0.9s;"></div>
			<div class="particle" style="--tx: 600px; --ty: 750px; --angle: 51.34deg; animation: warpSpeed 2.2s linear infinite 1s;"></div>
			<div class="particle" style="--tx: -850px; --ty: -650px; --angle: -142.43deg; animation: warpSpeed 2s linear infinite 1.1s;"></div>
			<div class="particle" style="--tx: 950px; --ty: 350px; --angle: 20.22deg; animation: warpSpeed 1.9s linear infinite 1.2s;"></div>
			<div class="particle" style="--tx: -750px; --ty: 800px; --angle: 133.17deg; animation: warpSpeed 2.3s linear infinite 1.3s;"></div>
			<div class="particle" style="--tx: 800px; --ty: -700px; --angle: -41.19deg; animation: warpSpeed 2.1s linear infinite 1.4s;"></div>
			<div class="particle" style="--tx: -900px; --ty: 500px; --angle: 150.95deg; animation: warpSpeed 2.4s linear infinite 1.5s;"></div>
			<div class="particle" style="--tx: 750px; --ty: -750px; --angle: -45deg; animation: warpSpeed 1.8s linear infinite 1.6s;"></div>
			<div class="particle" style="--tx: -800px; --ty: 650px; --angle: 140.91deg; animation: warpSpeed 2.2s linear infinite 1.7s;"></div>
			<div class="particle" style="--tx: 900px; --ty: 700px; --angle: 37.87deg; animation: warpSpeed 2s linear infinite 1.8s;"></div>
			<div class="particle" style="--tx: -750px; --ty: -750px; --angle: -135deg; animation: warpSpeed 2.5s linear infinite 1.9s;"></div>
		</div>

		<div class="container">
			<header class="header">
				<img src="/avatar.jpg" alt="Avatar" class="avatar" />
				<h1 class="site-title glitch-text" data-text="时间的碎片">时间的碎片</h1>
				<p class="site-subtitle glitch-text" data-text="漂浮在记忆与遗忘之间">漂浮在记忆与遗忘之间</p>
			</header>

			<div class="carousel-container">
				<div class="carousel" id="carousel">
					<a href="/blog/fragment-1" class="document">
						<h2 class="doc-title glitch-text" data-text="玻璃上的裂痕">玻璃上的裂痕</h2>
						<div class="doc-date">2026.03.14</div>
						<p class="doc-excerpt">
							时钟停在了三点十五分。窗外的雨一直在下。手心的纹路像是某种古老的密码。我盯着看了很久。
						</p>
					</a>

					<a href="/blog/fragment-2" class="document">
						<h2 class="doc-title glitch-text" data-text="蓝色的回声">蓝色的回声</h2>
						<div class="doc-date">2026.02.28</div>
						<p class="doc-excerpt">
							梦里有人在唱歌。醒来时嘴里还残留着旋律的碎片。每一个音符都指向不同的方向。
						</p>
					</a>

					<a href="/blog/fragment-3" class="document">
						<h2 class="doc-title glitch-text" data-text="漂浮的房间">漂浮的房间</h2>
						<div class="doc-date">2026.01.17</div>
						<p class="doc-excerpt">
							墙壁开始呼吸。我数着它的节奏。一下，两下，三下。然后忘记了为什么要数。
						</p>
					</a>

					<a href="/blog/fragment-4" class="document">
						<h2 class="doc-title glitch-text" data-text="透明的重量">透明的重量</h2>
						<div class="doc-date">2025.12.09</div>
						<p class="doc-excerpt">
							空气有重量吗？我把手伸进虚空。感觉到了什么。或许什么都没有。镜子里的人在笑。
						</p>
					</a>

					<a href="/blog/fragment-5" class="document">
						<h2 class="doc-title glitch-text" data-text="消失的边界">消失的边界</h2>
						<div class="doc-date">2025.11.23</div>
						<p class="doc-excerpt">
							哪里是开始，哪里是结束？我站在两者之间。花瓣在空中旋转，永远不会落地。
						</p>
					</a>
				</div>
			</div>
		</div>

		<div class="control-btn music-control" id="musicControl">
			<span id="musicIcon">🎶</span>
		</div>

		<div class="control-btn settings-btn" id="settingsBtn">
			⚙️
		</div>

		<div class="settings-panel" id="settingsPanel">
			<div class="setting-item">
				<label class="setting-label">透明度: <span id="opacityValue">30%</span></label>
				<input type="range" min="10" max="90" value="30" class="slider" id="opacitySlider" />
			</div>
			<div class="setting-item">
				<label class="setting-label">主题色调: <span id="hueValue">209°</span></label>
				<input type="range" min="0" max="360" value="209" class="slider" id="hueSlider" />
			</div>
		</div>

		<audio id="bgMusic" loop autoplay>
			<source src="/music.mp3" type="audio/mpeg" />
		</audio>

		<script>
			// 创建往背景深处坠落的粒子
			function createFallingParticles() {
				const container = document.getElementById('fallingParticles');
				if (!container) return;

				for (let i = 0; i < 150; i++) {
					const particle = document.createElement('div');
					particle.className = 'particle';
					particle.style.left = Math.random() * 100 + '%';
					particle.style.top = Math.random() * 100 + '%';
					particle.style.animationDuration = (Math.random() * 6 + 5) + 's';
					particle.style.animationDelay = Math.random() * 10 + 's';
					container.appendChild(particle);
				}

				console.log('粒子已创建:', container.children.length);
			}

			// 音乐控制
			const music = document.getElementById('bgMusic');
			const musicControl = document.getElementById('musicControl');
			const musicIcon = document.getElementById('musicIcon');
			let isPlaying = true;

			music.play().catch(() => {
				isPlaying = false;
				musicIcon.textContent = '🎵';
			});

			musicControl.addEventListener('click', () => {
				if (isPlaying) {
					music.pause();
					musicIcon.textContent = '🎵';
				} else {
					music.play();
					musicIcon.textContent = '🎶';
				}
				isPlaying = !isPlaying;
			});

			// 设置面板
			const settingsBtn = document.getElementById('settingsBtn');
			const settingsPanel = document.getElementById('settingsPanel');

			settingsBtn.addEventListener('click', () => {
				settingsPanel.classList.toggle('active');
			});

			// 透明度控制
			const opacitySlider = document.getElementById('opacitySlider');
			const opacityValue = document.getElementById('opacityValue');

			opacitySlider.addEventListener('input', (e) => {
				const value = e.target.value / 100;
				document.documentElement.style.setProperty('--opacity', value);
				opacityValue.textContent = e.target.value + '%';
			});

			// 色调控制
			const hueSlider = document.getElementById('hueSlider');
			const hueValue = document.getElementById('hueValue');

			hueSlider.addEventListener('input', (e) => {
				document.documentElement.style.setProperty('--primary-hue', e.target.value);
				hueValue.textContent = e.target.value + '°';
			});

			// 初始化
			createFallingParticles();
		</script>
	</body>
</html>
