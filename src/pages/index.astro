---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="时间的碎片" description="漂浮在记忆与遗忘之间" />
		<link rel="icon" type="image/jpeg" href="/avatar.jpg" />
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--primary-hue: 280;
				--opacity: 0.3;
			}

			body {
				font-family: 'Georgia', 'Songti SC', serif;
				background: url('/background.jpg') center/cover fixed;
				color: #fff;
				overflow-x: hidden;
				min-height: 100vh;
				perspective: 1500px;
			}

			.overlay {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: rgba(0, 0, 0, 0.5);
				pointer-events: none;
				z-index: 0;
			}

			/* 破碎文字效果 */
			.glitch-text {
				position: relative;
				animation: glitch-skew 3s infinite;
			}

			.glitch-text::before,
			.glitch-text::after {
				content: attr(data-text);
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
			}

			.glitch-text::before {
				left: 2px;
				text-shadow: -2px 0 #ff00de;
				clip: rect(24px, 550px, 90px, 0);
				animation: glitch-anim 2s infinite linear alternate-reverse;
			}

			.glitch-text::after {
				left: -2px;
				text-shadow: -2px 0 #00fff9, 2px 2px #ff00de;
				clip: rect(85px, 550px, 140px, 0);
				animation: glitch-anim 3s infinite linear alternate-reverse;
			}

			@keyframes glitch-anim {
				0% { clip: rect(61px, 9999px, 50px, 0); }
				10% { clip: rect(91px, 9999px, 28px, 0); }
				20% { clip: rect(65px, 9999px, 73px, 0); }
				30% { clip: rect(17px, 9999px, 14px, 0); }
				40% { clip: rect(53px, 9999px, 96px, 0); }
				50% { clip: rect(37px, 9999px, 81px, 0); }
				60% { clip: rect(72px, 9999px, 43px, 0); }
				70% { clip: rect(26px, 9999px, 58px, 0); }
				80% { clip: rect(84px, 9999px, 11px, 0); }
				90% { clip: rect(19px, 9999px, 67px, 0); }
				100% { clip: rect(45px, 9999px, 32px, 0); }
			}

			@keyframes glitch-skew {
				0% { transform: skew(0deg); }
				10% { transform: skew(-2deg); }
				20% { transform: skew(1deg); }
				30% { transform: skew(0deg); }
				40% { transform: skew(1deg); }
				50% { transform: skew(-1deg); }
				60% { transform: skew(0deg); }
				70% { transform: skew(2deg); }
				80% { transform: skew(-1deg); }
				90% { transform: skew(1deg); }
				100% { transform: skew(0deg); }
			}

			.container {
				position: relative;
				z-index: 2;
				max-width: 1200px;
				margin: 0 auto;
				padding: 2rem;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
			}

			.header {
				text-align: center;
				margin-bottom: 5rem;
				animation: fadeInDown 1.5s ease-out;
			}

			.avatar {
				width: 120px;
				height: 120px;
				border-radius: 50%;
				border: 3px solid rgba(255, 255, 255, 0.3);
				margin-bottom: 1.5rem;
				animation: float 6s ease-in-out infinite;
				box-shadow: 0 0 40px rgba(255, 255, 255, 0.4);
				filter: brightness(1.1);
			}

			.site-title {
				font-size: 3rem;
				font-weight: 300;
				letter-spacing: 0.5rem;
				margin-bottom: 0.5rem;
				text-shadow: 0 0 30px rgba(255, 255, 255, 0.6);
			}

			.site-subtitle {
				font-size: 1.1rem;
				opacity: 0.8;
				font-style: italic;
				letter-spacing: 0.3rem;
				animation: flicker 4s infinite;
			}

			/* 3D旋转文档柜 */
			.carousel-container {
				width: 100%;
				height: 500px;
				position: relative;
				transform-style: preserve-3d;
			}

			.carousel {
				width: 100%;
				height: 100%;
				position: absolute;
				transform-style: preserve-3d;
				animation: rotate 30s infinite linear;
			}

			.carousel:hover {
				animation-play-state: paused;
			}

			.document {
				position: absolute;
				width: 300px;
				height: 400px;
				left: 50%;
				top: 50%;
				margin-left: -150px;
				margin-top: -200px;
				background: hsla(var(--primary-hue), 30%, 20%, var(--opacity));
				backdrop-filter: blur(15px);
				border: 1px solid rgba(255, 255, 255, 0.2);
				border-radius: 15px;
				padding: 2rem;
				cursor: pointer;
				transition: all 0.5s ease;
				transform-style: preserve-3d;
				box-shadow: 0 10px 50px rgba(0, 0, 0, 0.5);
			}

			.document:hover {
				transform: translateZ(100px) scale(1.1) !important;
				background: hsla(var(--primary-hue), 40%, 30%, calc(var(--opacity) + 0.2));
				box-shadow: 0 20px 80px rgba(0, 0, 0, 0.7);
				z-index: 10;
			}

			.document:nth-child(1) { transform: rotateY(0deg) translateZ(450px); }
			.document:nth-child(2) { transform: rotateY(72deg) translateZ(450px); }
			.document:nth-child(3) { transform: rotateY(144deg) translateZ(450px); }
			.document:nth-child(4) { transform: rotateY(216deg) translateZ(450px); }
			.document:nth-child(5) { transform: rotateY(288deg) translateZ(450px); }

			.doc-title {
				font-size: 1.8rem;
				margin-bottom: 1rem;
				color: #fff;
				text-decoration: none;
				display: block;
				text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
			}

			.doc-date {
				font-size: 0.9rem;
				opacity: 0.6;
				margin-bottom: 1.5rem;
				letter-spacing: 0.1rem;
			}

			.doc-excerpt {
				line-height: 1.8;
				opacity: 0.85;
				font-size: 0.95rem;
			}

			/* 设置按钮 */
			.settings-btn {
				position: fixed;
				bottom: 2rem;
				right: 2rem;
				width: 60px;
				height: 60px;
				background: hsla(var(--primary-hue), 50%, 50%, 0.4);
				backdrop-filter: blur(10px);
				border: 1px solid rgba(255, 255, 255, 0.3);
				border-radius: 50%;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.5rem;
				transition: all 0.3s;
				z-index: 1000;
				animation: pulse 2s infinite;
			}

			.settings-btn:hover {
				transform: scale(1.1) rotate(90deg);
				background: hsla(var(--primary-hue), 50%, 50%, 0.6);
			}

			.settings-panel {
				position: fixed;
				bottom: 5rem;
				right: 2rem;
				width: 300px;
				background: hsla(var(--primary-hue), 30%, 20%, 0.95);
				backdrop-filter: blur(20px);
				border: 1px solid rgba(255, 255, 255, 0.3);
				border-radius: 15px;
				padding: 1.5rem;
				display: none;
				z-index: 999;
				animation: slideInUp 0.3s ease-out;
			}

			.settings-panel.active {
				display: block;
			}

			.setting-item {
				margin-bottom: 1.5rem;
			}

			.setting-label {
				display: block;
				margin-bottom: 0.5rem;
				font-size: 0.9rem;
				opacity: 0.9;
			}

			.slider {
				width: 100%;
				height: 6px;
				border-radius: 3px;
				background: rgba(255, 255, 255, 0.2);
				outline: none;
				-webkit-appearance: none;
			}

			.slider::-webkit-slider-thumb {
				-webkit-appearance: none;
				width: 16px;
				height: 16px;
				border-radius: 50%;
				background: hsl(var(--primary-hue), 70%, 70%);
				cursor: pointer;
			}

			.music-control {
				position: fixed;
				bottom: 2rem;
				left: 2rem;
				width: 60px;
				height: 60px;
				background: hsla(var(--primary-hue), 50%, 50%, 0.4);
				backdrop-filter: blur(10px);
				border: 1px solid rgba(255, 255, 255, 0.3);
				border-radius: 50%;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.5rem;
				transition: all 0.3s;
				z-index: 1000;
				animation: pulse 2s infinite 0.5s;
			}

			.music-control:hover {
				transform: scale(1.1);
				background: hsla(var(--primary-hue), 50%, 50%, 0.6);
			}

			@keyframes rotate {
				from { transform: rotateY(0deg); }
				to { transform: rotateY(360deg); }
			}

			@keyframes fadeInDown {
				from {
					opacity: 0;
					transform: translateY(-50px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes float {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-20px); }
			}

			@keyframes pulse {
				0%, 100% { transform: scale(1); }
				50% { transform: scale(1.05); }
			}

			@keyframes flicker {
				0%, 100% { opacity: 0.8; }
				50% { opacity: 0.5; }
			}

			@keyframes slideInUp {
				from {
					opacity: 0;
					transform: translateY(20px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
		</style>
	</head>
	<body>
		<div class="overlay"></div>

		<div class="container">
			<header class="header">
				<img src="/avatar.jpg" alt="Avatar" class="avatar" />
				<h1 class="site-title glitch-text" data-text="时间的碎片">时间的碎片</h1>
				<p class="site-subtitle glitch-text" data-text="漂浮在记忆与遗忘之间">漂浮在记忆与遗忘之间</p>
			</header>

			<div class="carousel-container">
				<div class="carousel">
					<a href="/blog/fragment-1" class="document">
						<h2 class="doc-title glitch-text" data-text="玻璃上的裂痕">玻璃上的裂痕</h2>
						<div class="doc-date">2026.03.14</div>
						<p class="doc-excerpt">
							时钟停在了三点十五分。窗外的雨一直在下。手心的纹路像是某种古老的密码。我盯着看了很久。
						</p>
					</a>

					<a href="/blog/fragment-2" class="document">
						<h2 class="doc-title glitch-text" data-text="蓝色的回声">蓝色的回声</h2>
						<div class="doc-date">2026.02.28</div>
						<p class="doc-excerpt">
							梦里有人在唱歌。醒来时嘴里还残留着旋律的碎片。每一个音符都指向不同的方向。
						</p>
					</a>

					<a href="/blog/fragment-3" class="document">
						<h2 class="doc-title glitch-text" data-text="漂浮的房间">漂浮的房间</h2>
						<div class="doc-date">2026.01.17</div>
						<p class="doc-excerpt">
							墙壁开始呼吸。我数着它的节奏。一下，两下，三下。然后忘记了为什么要数。
						</p>
					</a>

					<a href="/blog/fragment-4" class="document">
						<h2 class="doc-title glitch-text" data-text="透明的重量">透明的重量</h2>
						<div class="doc-date">2025.12.09</div>
						<p class="doc-excerpt">
							空气有重量吗？我把手伸进虚空。感觉到了什么。或许什么都没有。镜子里的人在笑。
						</p>
					</a>

					<a href="/blog/fragment-5" class="document">
						<h2 class="doc-title glitch-text" data-text="消失的边界">消失的边界</h2>
						<div class="doc-date">2025.11.23</div>
						<p class="doc-excerpt">
							哪里是开始，哪里是结束？我站在两者之间。花瓣在空中旋转，永远不会落地。
						</p>
					</a>
				</div>
			</div>
		</div>

		<div class="music-control" id="musicControl">
			<span id="musicIcon">🎶</span>
		</div>

		<div class="settings-btn" id="settingsBtn">
			⚙️
		</div>

		<div class="settings-panel" id="settingsPanel">
			<div class="setting-item">
				<label class="setting-label">透明度: <span id="opacityValue">30%</span></label>
				<input type="range" min="10" max="90" value="30" class="slider" id="opacitySlider" />
			</div>
			<div class="setting-item">
				<label class="setting-label">主题色调: <span id="hueValue">280°</span></label>
				<input type="range" min="0" max="360" value="280" class="slider" id="hueSlider" />
			</div>
		</div>

		<audio id="bgMusic" loop autoplay>
			<source src="/music.mp3" type="audio/mpeg" />
		</audio>

		<script>
			// 音乐自动播放（处理浏览器限制）
			const music = document.getElementById('bgMusic');
			const musicControl = document.getElementById('musicControl');
			const musicIcon = document.getElementById('musicIcon');
			let isPlaying = true;

			// 尝试自动播放
			music.play().catch(() => {
				// 如果自动播放被阻止，等待用户交互
				isPlaying = false;
				musicIcon.textContent = '🎵';
			});

			musicControl.addEventListener('click', () => {
				if (isPlaying) {
					music.pause();
					musicIcon.textContent = '🎵';
				} else {
					music.play();
					musicIcon.textContent = '🎶';
				}
				isPlaying = !isPlaying;
			});

			// 设置面板
			const settingsBtn = document.getElementById('settingsBtn');
			const settingsPanel = document.getElementById('settingsPanel');

			settingsBtn.addEventListener('click', () => {
				settingsPanel.classList.toggle('active');
			});

			// 透明度控制
			const opacitySlider = document.getElementById('opacitySlider');
			const opacityValue = document.getElementById('opacityValue');

			opacitySlider.addEventListener('input', (e) => {
				const value = e.target.value / 100;
				document.documentElement.style.setProperty('--opacity', value);
				opacityValue.textContent = e.target.value + '%';
			});

			// 色调控制
			const hueSlider = document.getElementById('hueSlider');
			const hueValue = document.getElementById('hueValue');

			hueSlider.addEventListener('input', (e) => {
				document.documentElement.style.setProperty('--primary-hue', e.target.value);
				hueValue.textContent = e.target.value + '°';
			});
		</script>
	</body>
</html>
