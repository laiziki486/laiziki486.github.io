<!DOCTYPE html>
<html lang="zh-CN">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>母亲节快乐</title>
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: 'Georgia', 'Songti SC', 'SimSun', serif;
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: hidden;
			position: relative;
		}

		/* 背景图层 - 带水波动画 */
		body::before {
			content: '';
			position: fixed;
			top: -5%;
			left: -5%;
			width: 110%;
			height: 110%;
			background: url('/mothers-day-bg.jpg') center/cover;
			z-index: -2;
			animation: waterRipple 6s ease-in-out infinite;
		}

		/* 轻微遮罩提升文字可读性 */
		body::after {
			content: '';
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.1);
			z-index: -1;
		}

		/* 水波粼粼动画 */
		@keyframes waterRipple {
			0%, 100% {
				transform: scale(1) translate(0, 0);
				filter: brightness(1.1);
			}
			25% {
				transform: scale(1.02) translate(-1%, 0.5%);
				filter: brightness(1.15);
			}
			50% {
				transform: scale(1.01) translate(0.5%, -0.5%);
				filter: brightness(1.12);
			}
			75% {
				transform: scale(1.02) translate(-0.5%, 1%);
				filter: brightness(1.15);
			}
		}

		.container {
			position: relative;
			z-index: 100;
			text-align: center;
			padding: 2rem;
		}

		.title {
			font-size: 4rem;
			font-weight: bold;
			margin-bottom: 3rem;
			line-height: 1.5;
		}

		.content {
			font-size: 2rem;
			line-height: 2;
			max-width: 800px;
			margin: 0 auto;
		}

		/* 彩色文字 */
		.char {
			display: inline-block;
			font-weight: bold;
		}

		/* 响应式设计 */
		@media (max-width: 768px) {
			.title {
				font-size: 2.5rem;
			}
			.content {
				font-size: 1.3rem;
			}
		}
	</style>
</head>
<body>
	<div class="container">
		<div class="title" id="title"></div>
		<div class="content" id="content"></div>
	</div>

	<script>
		// 颜色池 - 温暖的粉色、红色、橙色、紫色系
		const colors = [
			'#ff69b4', // 热粉色
			'#ff1493', // 深粉色
			'#ff6347', // 番茄红
			'#ff4500', // 橙红色
			'#ffa500', // 橙色
			'#ff69b4', // 热粉色
			'#da70d6', // 兰花紫
			'#ba55d3', // 中兰花紫
			'#ff1493', // 深粉色
			'#ff6347'  // 番茄红
		];

		// 标题文字
		const titleText = '亲爱的妈妈\n祝您母亲节快乐！';

		// 正文文字
		const contentText = '感谢您一直以来的关爱与付出，\n您的温暖是我前行的力量。\n愿您永远健康快乐，笑容常在。\n妈妈，我爱您！';

		// 将文字转换为彩色字符
		function colorizeText(text, container) {
			const lines = text.split('\n');
			let colorIndex = 0;

			lines.forEach((line, lineIndex) => {
				if (lineIndex > 0) {
					container.appendChild(document.createElement('br'));
				}

				for (let char of line) {
					const span = document.createElement('span');
					span.className = 'char';
					span.textContent = char;
					span.style.color = colors[colorIndex % colors.length];
					container.appendChild(span);
					colorIndex++;
				}
			});
		}

		// 初始化页面
		const titleContainer = document.getElementById('title');
		const contentContainer = document.getElementById('content');

		colorizeText(titleText, titleContainer);
		colorizeText(contentText, contentContainer);

		// 硬编码闪烁效果 - 使用JavaScript直接操作
		const allChars = document.querySelectorAll('.char');
		let blinkState = false;

		setInterval(() => {
			blinkState = !blinkState;

			allChars.forEach((char, index) => {
				if (blinkState) {
					// 闪烁状态 - 强光晕
					char.style.textShadow = `
						0 0 20px ${char.style.color},
						0 0 40px ${char.style.color},
						0 0 60px ${char.style.color},
						0 0 80px ${char.style.color}
					`;
				} else {
					// 正常状态 - 弱光晕
					char.style.textShadow = `
						0 0 10px ${char.style.color},
						0 0 20px ${char.style.color}
					`;
				}
			});
		}, 500); // 每500毫秒切换一次，实现僵硬的闪烁效果
	</script>
</body>
</html>
