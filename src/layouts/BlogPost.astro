---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--primary-hue: 209;
				--opacity: 0.3;
			}

			body {
				font-family: 'Georgia', 'Songti SC', serif;
				background: url('/background.jpg') center/cover fixed;
				color: #fff;
				overflow-x: hidden;
				min-height: 100vh;
				line-height: 1.8;
			}

			.overlay {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: rgba(0, 0, 0, 0.5);
				pointer-events: none;
				z-index: 0;
			}

			.container {
				position: relative;
				z-index: 2;
				max-width: 800px;
				margin: 0 auto;
				padding: 3rem 2rem;
				min-height: 100vh;
			}

			.back-link {
				display: inline-block;
				margin-bottom: 2rem;
				color: rgba(200, 200, 200, 0.8);
				text-decoration: none;
				text-decoration-color: rgba(255, 255, 255, 0.3);
				font-size: 1rem;
				transition: all 0.3s;
				animation: fadeIn 1s ease-out;
			}

			.back-link:hover {
				color: rgba(255, 255, 255, 0.9);
				text-decoration-color: rgba(255, 255, 255, 0.6);
				transform: translateX(-5px);
			}

			.article-header {
				text-align: center;
				margin-bottom: 3rem;
				animation: fadeInDown 1s ease-out;
			}

			.article-title {
				font-size: 2.5rem;
				font-weight: 300;
				letter-spacing: 0.3rem;
				margin-bottom: 1rem;
				text-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
				animation: glitch 5s infinite;
			}

			.article-date {
				font-size: 0.9rem;
				opacity: 0.6;
				letter-spacing: 0.2rem;
				color: rgba(200, 200, 200, 0.8);
			}

			.article-content {
				background: hsla(var(--primary-hue), 30%, 20%, var(--opacity));
				backdrop-filter: blur(15px);
				border: 2px solid rgba(255, 255, 255, 0.3);
				border-radius: 15px;
				padding: 3rem;
				animation: fadeInUp 1.2s ease-out;
				box-shadow: 0 10px 50px rgba(0, 0, 0, 0.5);
			}

			.article-content :global(p) {
				margin-bottom: 1.5rem;
				font-size: 1.1rem;
				opacity: 0.95;
				text-align: left;
				color: rgba(250, 248, 245, 0.98);
			}

			.article-content :global(p:last-child) {
				margin-bottom: 0;
			}

			.control-btn {
				position: fixed;
				width: 70px;
				height: 70px;
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 60%, 40%, 0.4),
					hsla(var(--primary-hue), 60%, 30%, 0.6));
				backdrop-filter: blur(15px);
				border: 2px solid rgba(255, 255, 255, 0.4);
				border-radius: 50%;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.8rem;
				transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
				z-index: 1000;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4),
				            inset 0 0 20px rgba(255, 255, 255, 0.1);
			}

			.control-btn::before {
				content: '';
				position: absolute;
				inset: -2px;
				border-radius: 50%;
				padding: 2px;
				background: linear-gradient(45deg,
					transparent,
					rgba(255, 255, 255, 0.5),
					transparent);
				-webkit-mask: linear-gradient(#fff 0 0) content-box,
				              linear-gradient(#fff 0 0);
				-webkit-mask-composite: xor;
				mask-composite: exclude;
				opacity: 0;
				transition: opacity 0.4s;
			}

			.control-btn:hover {
				transform: scale(1.15);
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 70%, 50%, 0.6),
					hsla(var(--primary-hue), 70%, 40%, 0.8));
				box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6),
				            0 0 40px rgba(255, 255, 255, 0.4),
				            inset 0 0 30px rgba(255, 255, 255, 0.2);
				border-color: rgba(255, 255, 255, 0.8);
			}

			.control-btn:hover::before {
				opacity: 1;
			}

			.control-btn:active {
				transform: scale(1.05);
			}

			.music-control {
				bottom: 2rem;
				left: 2rem;
			}

			.settings-btn {
				bottom: 2rem;
				right: 2rem;
			}

			.settings-btn:hover {
				transform: scale(1.15) rotate(90deg);
			}

			.settings-panel {
				position: fixed;
				bottom: 5.5rem;
				right: 2rem;
				width: 320px;
				background: linear-gradient(135deg,
					hsla(var(--primary-hue), 30%, 20%, 0.95),
					hsla(var(--primary-hue), 30%, 15%, 0.98));
				backdrop-filter: blur(25px);
				border: 2px solid rgba(255, 255, 255, 0.3);
				border-radius: 20px;
				padding: 2rem;
				display: none;
				z-index: 999;
				animation: slideInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6),
				            inset 0 0 30px rgba(255, 255, 255, 0.05);
			}

			.settings-panel.active {
				display: block;
			}

			.setting-item {
				margin-bottom: 2rem;
			}

			.setting-item:last-child {
				margin-bottom: 0;
			}

			.setting-label {
				display: block;
				margin-bottom: 0.8rem;
				font-size: 0.95rem;
				opacity: 0.9;
				letter-spacing: 0.05rem;
			}

			.slider {
				width: 100%;
				height: 8px;
				border-radius: 4px;
				background: linear-gradient(90deg,
					rgba(255, 255, 255, 0.2),
					rgba(255, 255, 255, 0.4));
				outline: none;
				-webkit-appearance: none;
			}

			.slider::-webkit-slider-thumb {
				-webkit-appearance: none;
				width: 20px;
				height: 20px;
				border-radius: 50%;
				background: linear-gradient(135deg,
					hsl(var(--primary-hue), 80%, 60%),
					hsl(var(--primary-hue), 80%, 50%));
				cursor: pointer;
				box-shadow: 0 4px 12px rgba(255, 255, 255, 0.5),
				            inset 0 0 8px rgba(255, 255, 255, 0.3);
				transition: all 0.3s;
			}

			.slider::-webkit-slider-thumb:hover {
				transform: scale(1.2);
				box-shadow: 0 6px 20px rgba(255, 255, 255, 0.7),
				            inset 0 0 12px rgba(255, 255, 255, 0.4);
			}

			@keyframes fadeIn {
				from { opacity: 0; }
				to { opacity: 1; }
			}

			@keyframes fadeInDown {
				from {
					opacity: 0;
					transform: translateY(-30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes fadeInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes glitch {
				0%, 90%, 100% { transform: translate(0); }
				92% { transform: translate(-2px, 2px); }
				94% { transform: translate(2px, -2px); }
				96% { transform: translate(-2px, -2px); }
			}

			@keyframes slideInUp {
				from {
					opacity: 0;
					transform: translateY(30px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
		</style>
	</head>
	<body>
		<div class="overlay"></div>

		<div class="container">
			<a href="/" class="back-link">← 返回</a>

			<header class="article-header">
				<h1 class="article-title">{title}</h1>
				<div class="article-date">
					<FormattedDate date={pubDate} />
				</div>
			</header>

			<article class="article-content">
				<slot />
			</article>
		</div>

		<div class="control-btn music-control" id="musicControl">
			<span id="musicIcon">🎶</span>
		</div>

		<div class="control-btn settings-btn" id="settingsBtn">
			⚙️
		</div>

		<div class="settings-panel" id="settingsPanel">
			<div class="setting-item">
				<label class="setting-label">透明度: <span id="opacityValue">30%</span></label>
				<input type="range" min="10" max="90" value="30" class="slider" id="opacitySlider" />
			</div>
			<div class="setting-item">
				<label class="setting-label">主题色调: <span id="hueValue">209°</span></label>
				<input type="range" min="0" max="360" value="209" class="slider" id="hueSlider" />
			</div>
		</div>

		<audio id="bgMusic" loop autoplay>
			<source src="/music.mp3" type="audio/mpeg" />
		</audio>

		<script>
			const music = document.getElementById('bgMusic');
			const musicControl = document.getElementById('musicControl');
			const musicIcon = document.getElementById('musicIcon');
			let isPlaying = true;

			music.play().catch(() => {
				isPlaying = false;
				musicIcon.textContent = '🎵';
			});

			musicControl.addEventListener('click', () => {
				if (isPlaying) {
					music.pause();
					musicIcon.textContent = '🎵';
				} else {
					music.play();
					musicIcon.textContent = '🎶';
				}
				isPlaying = !isPlaying;
			});

			const settingsBtn = document.getElementById('settingsBtn');
			const settingsPanel = document.getElementById('settingsPanel');

			settingsBtn.addEventListener('click', () => {
				settingsPanel.classList.toggle('active');
			});

			const opacitySlider = document.getElementById('opacitySlider');
			const opacityValue = document.getElementById('opacityValue');

			opacitySlider.addEventListener('input', (e) => {
				const value = e.target.value / 100;
				document.documentElement.style.setProperty('--opacity', value);
				opacityValue.textContent = e.target.value + '%';
			});

			const hueSlider = document.getElementById('hueSlider');
			const hueValue = document.getElementById('hueValue');

			hueSlider.addEventListener('input', (e) => {
				document.documentElement.style.setProperty('--primary-hue', e.target.value);
				hueValue.textContent = e.target.value + '°';
			});
		</script>
	</body>
</html>
